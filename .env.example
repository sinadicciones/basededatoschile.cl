# === Asistente de IA (obligatorio para el chat conversacional) ===
# API key de Anthropic. Consíguela en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo a usar (opcional). Por defecto: claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# === Shopify ===
# Dominio público de tu tienda (donde vive el checkout). Sin https://
NEXT_PUBLIC_SHOPIFY_DOMAIN=basededatoschile.cl
# Dominio .myshopify.com (para la Storefront API). Sin https://
SHOPIFY_STORE_DOMAIN=basededatoschile-cl.myshopify.com
# Token público de la Storefront API (opcional). Si lo defines, el catálogo
# se refresca en vivo desde Shopify. Si no, se usa data/catalog.json (snapshot).
# Crea uno en: Shopify Admin > Settings > Apps > Develop apps > Storefront API
SHOPIFY_STOREFRONT_TOKEN=

# URL canónica del sitio (para SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://basededatoschile.cl
